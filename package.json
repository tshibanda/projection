{
  "name": "verseflow",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "electron:dev": "electron .",
    "predist:mac": "rm -rf .deploy-mac && mkdir -p .deploy-mac && cp package.json package-lock.json .deploy-mac/ && cd .deploy-mac && npm install --omit=dev --no-audit --no-fund",
    "dist:mac": "next build && electron-builder --mac --arm64",
    "predist:win": "rm -rf .deploy-win && mkdir -p .deploy-win && cp package.json package-lock.json .deploy-win/ && cd .deploy-win && npm install --omit=dev --no-audit --no-fund",
    "dist:win": "next build && electron-builder --win --x64"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  },
  "build": {
    "appId": "com.verseflow.desktop",
    "productName": "VerseFlow",
    "asar": false,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "app",
        "filter": [
          "package.json",
          "next.config.mjs",
          ".next/**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "extraResources": [
        {
          "from": ".deploy-mac/node_modules",
          "to": "app/node_modules"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": ".deploy-win/node_modules",
          "to": "app/node_modules"
        }
      ]
    }
  }
}
